# Defaults fail closed: no authentication or GA4 provider network access occurs.
FIRSTLINE_MODE=production
FIRSTLINE_EXTERNAL_ACCESS=false
FIRSTLINE_GA4_MODE=disabled
FIRSTLINE_OWNER_EMAIL=firstlinedevnt@gmail.com
FIRSTLINE_FIREBASE_PROJECT_ID=
FIRSTLINE_FUNCTION_REGION=
