{
  "name": "firstline-analytics",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "main": "apps/api/dist/functions.js",
  "files": [
    "apps/api/dist",
    "packages/contracts/dist",
    "packages/contracts/package.json",
    "package-lock.json"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.22.2 <23.0.0"
  },
  "scripts": {
    "dev:local": "concurrently -k \"npm run dev -w @firstline/web\" \"npm run serve -w @firstline/api\"",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "build": "npm run build -w @firstline/contracts && npm run build -w @firstline/api && npm run build -w @firstline/web",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:contracts": "tsx --test tests/contracts/*.test.ts",
    "test:security": "tsx --test tests/security/*.test.ts",
    "test:e2e": "tsx --test tests/e2e/*.test.ts",
    "check:function-package": "npm run build && node scripts/check-functions-package.mjs"
  },
  "dependencies": {
    "@firstline/contracts": "file:packages/contracts",
    "express": "4.22.3",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "google-auth-library": "9.15.1"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.13.6"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@firebase/app": "0.14.6",
    "@firebase/app-compat": "0.5.6",
    "@types/express": "5.0.0",
    "@types/node": "22.13.4",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "eslint": "9.39.5",
    "express": "4.22.3",
    "firebase": "12.7.0",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.34.0",
    "globals": "15.15.0",
    "playwright": "1.64.1",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.72.0",
    "vite": "6.4.5"
  }
}
